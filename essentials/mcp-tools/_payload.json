01],{"class":636},"User",[427,1103,1104],{"class":433}," =>\n",[427,1106,1107,1110,1112,1115,1117,1119,1122,1124,1126,1128,1130,1133,1135],{"class":429,"line":471},[427,1108,1109],{"class":636},"    User",[427,1111,639],{"class":433},[427,1113,1114],{"class":642},"firstWhere",[427,1116,646],{"class":433},[427,1118,434],{"class":433},[427,1120,1121],{"class":437},"email",[427,1123,434],{"class":433},[427,1125,655],{"class":433},[427,1127,1089],{"class":433},[427,1129,1092],{"class":608},[427,1131,1132],{"class":433},"->",[427,1134,1121],{"class":608},[427,1136,1137],{"class":433},"));\n",[109,1139,1140,1141,1144],{},"Register it in a provider, never in config — a closure in a config file breaks\n",[148,1142,1143],{},"config:cache",". If no author resolves, the tool reports the misconfiguration instead of\nguessing.",[113,1146,1148],{"id":1147},"images","Images",[109,1150,1151,1152,1155,1156,1158,1159,1162,1163,1166,1167,1170,1171,1170,1174,582,1177,1180,1181,1184,1185,1188,1189,1191,1192,1195],{},"MCP's ",[148,1153,1154],{},"tools\u002Fcall"," arguments are plain JSON — there is no binary channel for tool inputs —\nso ",[148,1157,275],{}," accepts either a fetchable ",[148,1160,1161],{},"url"," or base64-encoded ",[148,1164,1165],{},"data"," (exactly one\nof the two). The image type is detected by sniffing the actual bytes, never trusted from a\nfilename or extension; only ",[148,1168,1169],{},"jpeg",", ",[148,1172,1173],{},"png",[148,1175,1176],{},"gif",[148,1178,1179],{},"webp"," are accepted (no ",[148,1182,1183],{},"svg"," — it's a\nstored-XSS vector). Size is capped by ",[148,1186,1187],{},"ink.uploads.max_bytes"," — a HEAD request rejects an\noversized ",[148,1190,1161],{}," by its ",[148,1193,1194],{},"Content-Length"," before the body is downloaded where the server\nadvertises one; the body itself is still measured against the cap either way.",[1197,1198,1199,1202,1203,1205,1206,1209,1210,1213,1214,1217,1218,1221,1222,1224,1225,1227],"caution",{},[688,1200,1201],{},"SSRF stance (accepted risk):"," the ",[148,1204,1161],{}," fetch is scheme-restricted (",[148,1207,1208],{},"http","\u002F",[148,1211,1212],{},"https"," only)\nbut has no host allowlist — it can reach any address your app server can reach, including\ninternal\u002Fprivate ones (e.g. a cloud metadata endpoint). This is an accepted risk, not an\noversight: the caller is already an authenticated, admin-scoped identity trusted to publish\ncontent (",[148,1215,1216],{},"upload-image"," shares ",[148,1219,1220],{},"create-post-tool","'s ",[148,1223,850],{}," Gate ability and ",[148,1226,192],{},"\ntoken ability), not an anonymous or low-privilege one. If your deployment needs a stricter\nboundary — blocking link-local and RFC1918 ranges, for example — enforce it at the network\nlayer in front of the app; there is no host-allowlist config in the package itself.",[417,1229,1231],{"className":419,"code":1230,"filename":421,"language":422,"meta":423,"style":423},"'uploads' => [\n    'disk' => 'public',       \u002F\u002F matches the Filament featured-image field's disk\n    'directory' => 'ink',     \u002F\u002F matches its directory too — panel and MCP uploads share a home\n    'max_bytes' => 3 * 1024 * 1024,\n],\n",[148,1232,1233,1246,1269,1292,1318],{"__ignoreMap":423},[427,1234,1235,1237,1240,1242,1244],{"class":429,"line":430},[427,1236,434],{"class":433},[427,1238,1239],{"class":437},"uploads",[427,1241,434],{"class":433},[427,1243,443],{"class":433},[427,1245,446],{"class":433},[427,1247,1248,1250,1253,1255,1257,1259,1262,1264,1266],{"class":429,"line":449},[427,1249,452],{"class":433},[427,1251,1252],{"class":437},"disk",[427,1254,434],{"class":433},[427,1256,443],{"class":433},[427,1258,503],{"class":433},[427,1260,1261],{"class":437},"public",[427,1263,434],{"class":433},[427,1265,655],{"class":433},[427,1267,1268],{"class":529},"       \u002F\u002F matches the Filament featured-image field's disk\n",[427,1270,1271,1273,1276,1278,1280,1282,1285,1287,1289],{"class":429,"line":465},[427,1272,452],{"class":433},[427,1274,1275],{"class":437},"directory",[427,1277,434],{"class":433},[427,1279,443],{"class":433},[427,1281,503],{"class":433},[427,1283,1284],{"class":437},"ink",[427,1286,434],{"class":433},[427,1288,655],{"class":433},[427,1290,1291],{"class":529},"     \u002F\u002F matches its directory too — panel and MCP uploads share a home\n",[427,1293,1294,1296,1299,1301,1303,1306,1309,1312,1314,1316],{"class":429,"line":471},[427,1295,452],{"class":433},[427,1297,1298],{"class":437},"max_bytes",[427,1300,434],{"class":433},[427,1302,443],{"class":433},[427,1304,1305],{"class":604}," 3",[427,1307,1308],{"class":433}," *",[427,1310,1311],{"class":604}," 1024",[427,1313,1308],{"class":433},[427,1315,1311],{"class":604},[427,1317,511],{"class":433},[427,1319,1320],{"class":429,"line":478},[427,1321,468],{"class":433},[1197,1323,1324,1333,1334,1336,1337,1339,1340,1344,1345,1347,1348,1350,1351,1354,1355,1357],{},[688,1325,1326,1328,1329,1332],{},[148,1327,1298],{}," and PHP's ",[148,1330,1331],{},"post_max_size"," (base64 uploads only):"," the base64 ",[148,1335,1165],{}," path is\nbound by PHP's ",[148,1338,1331],{}," — and any webserver\u002Fproxy body-size limit — ",[1341,1342,1343],"em",{},"before Laravel\never boots",". base64 inflates the binary size by ~4\u002F3, so an oversized payload is rejected by\nPHP itself: the client gets a raw PHP warning wrapped in an HTTP 200, not a clean JSON-RPC\nerror, and no app-level check (this one included) can catch it. The 3MB default (≈4MB\nbase64-encoded) stays safely under a common 5-8M ",[148,1346,1331],{}," floor; raise both together\nif you need a higher cap, keeping ",[148,1349,1331],{}," comfortably above ",[148,1352,1353],{},"max_bytes * 4\u002F3",". The\n",[148,1356,1161],{}," path has no such ceiling — the image is fetched by this server's own HTTP client, not\ncarried in the MCP request body at all — so prefer it for anything larger than a few MB.",[109,1359,1360,1361,1363,1364,1366,1367,1369,1370,1373,1374,1376,1377,1380],{},"The tool returns a ",[148,1362,496],{}," (pass it as ",[148,1365,198],{}," to ",[148,1368,1220],{}," \u002F\n",[148,1371,1372],{},"update-post-tool","), a public ",[148,1375,1161],{},", and a ready-to-paste ",[148,1378,1379],{},"markdown"," snippet for in-content\nimages:",[417,1382,1386],{"className":1383,"code":1384,"language":1385,"meta":423,"style":423},"language-json shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","{\n  \"path\": \"ink\u002F01hz...webp\",\n  \"url\": \"https:\u002F\u002Fexample.test\u002Fstorage\u002Fink\u002F01hz...webp\",\n  \"markdown\": \"![A dashboard screenshot](https:\u002F\u002Fexample.test\u002Fstorage\u002Fink\u002F01hz...webp)\"\n}\n","json",[148,1387,1388,1393,1415,1434,1452],{"__ignoreMap":423},[427,1389,1390],{"class":429,"line":430},[427,1391,1392],{"class":433},"{\n",[427,1394,1395,1398,1400,1403,1405,1408,1411,1413],{"class":429,"line":449},[427,1396,1397],{"class":433},"  \"",[427,1399,496],{"class":1079},[427,1401,1402],{"class":433},"\"",[427,1404,698],{"class":433},[427,1406,1407],{"class":433}," \"",[427,1409,1410],{"class":437},"ink\u002F01hz...webp",[427,1412,1402],{"class":433},[427,1414,511],{"class":433},[427,1416,1417,1419,1421,1423,1425,1427,1430,1432],{"class":429,"line":465},[427,1418,1397],{"class":433},[427,1420,1161],{"class":1079},[427,1422,1402],{"class":433},[427,1424,698],{"class":433},[427,1426,1407],{"class":433},[427,1428,1429],{"class":437},"https:\u002F\u002Fexample.test\u002Fstorage\u002Fink\u002F01hz...webp",[427,1431,1402],{"class":433},[427,1433,511],{"class":433},[427,1435,1436,1438,1440,1442,1444,1446,1449],{"class":429,"line":471},[427,1437,1397],{"class":433},[427,1439,1379],{"class":1079},[427,1441,1402],{"class":433},[427,1443,698],{"class":433},[427,1445,1407],{"class":433},[427,1447,1448],{"class":437},"![A dashboard screenshot](https:\u002F\u002Fexample.test\u002Fstorage\u002Fink\u002F01hz...webp)",[427,1450,1451],{"class":433},"\"\n",[427,1453,1454],{"class":429,"line":478},[427,1455,1456],{"class":433},"}\n",[109,1458,1459,1461,1462,1464,1465,1467,1468,1470,1471,1474,1475,1477,1478,1481,1482,1485,1486,582,1489,1492,1493,582,1496,1499,1500,1503],{},[148,1460,198],{}," on ",[148,1463,1220],{}," \u002F ",[148,1466,1372],{}," only accepts a path\n",[148,1469,1216],{}," itself produced — it's validated against the uploads disk and directory, so\nan agent can't point it at an arbitrary file. Pass ",[148,1472,1473],{},"featured_image: null"," on\n",[148,1476,1372],{}," to clear it. Rendering assumes the public disk with ",[148,1479,1480],{},"storage:link"," run —\nthe six ",[148,1483,1484],{},"asset('storage\u002F…')"," call sites documented in the README are unchanged by this\nfeature. Rendered post images get ",[148,1487,1488],{},"loading=\"lazy\"",[148,1490,1491],{},"decoding=\"async\""," automatically on\nboth render paths (",[148,1494,1495],{},"Post::toHtml()",[148,1497,1498],{},"Post::toSafeHtml()","), leaving any attribute the\nauthor declared by hand alone; there is no automatic resizing or ",[148,1501,1502],{},"srcset"," generation yet, so an\noversized source image still costs bandwidth and LCP — keep uploads reasonably sized until a\nresizing pipeline ships.",[113,1505,1507],{"id":1506},"scheduling","Scheduling",[109,1509,1510,1511,1514,1515,1518,1519,1522,1523,1525,1526,1529],{},"A post with ",[148,1512,1513],{},"status: \"published\""," and a future ",[148,1516,1517],{},"published_at"," is scheduled, not published\nimmediately: ",[148,1520,1521],{},"Post::published()"," is evaluated at query time, so the post appears on the\npublic index\u002Fshow\u002Ffeed\u002Fsitemap the moment the clock passes ",[148,1524,1517],{},", with no queue or\ncommand involved. Its signed preview URL (",[148,1527,1528],{},"generate-preview-url-tool",") keeps working right\nup until then.",[113,1531,1533],{"id":1532},"content-format","Content format",[109,1535,1536,1537,1539],{},"The tools store the ",[688,1538,1379],{}," you send, exactly as the Filament editor does; they do not\nconvert it to HTML. Rendering — and therefore HTML sanitisation — happens at read time\nthrough your application's markdown configuration.",[1197,1541,1542,1543,1546],{},"Posts created by ink 2.1 and earlier hold rendered HTML. The\n",[148,1544,1545],{},"convert_html_post_content_to_markdown"," migration converts them and prints the ids of any\nrow it could not convert cleanly, so you can review those by hand.",[113,1548,1550],{"id":1549},"extending","Extending",[109,1552,1553,1554,1557,1558,1561,1562,1565,1566,1569,1570,1170,1573,511,1576,582,1579,1582,1583,1586],{},"Custom blog tools should extend ",[148,1555,1556],{},"Relaticle\\Ink\\Mcp\\BlogTool"," rather than\n",[148,1559,1560],{},"Laravel\\Mcp\\Server\\Tool",". Its ",[148,1563,1564],{},"handle()"," is ",[148,1567,1568],{},"final"," and performs authorization before\ndelegating, so a new tool cannot ship without it. Declare ",[148,1571,1572],{},"ability()",[148,1574,1575],{},"tokenAbility()",[148,1577,1578],{},"model()",[148,1580,1581],{},"run()","; override ",[148,1584,1585],{},"resolveRecord()"," when the tool operates on one record.",[1588,1589,1590],"style",{},"html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sHwdD, html code.shiki .sHwdD{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#546E7A;--shiki-default-font-style:italic;--shiki-dark:#676E95;--shiki-dark-font-style:italic}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-li